# Copy to .env (gitignored) and fill in. Variables already set in the shell win.
LLM_GATEWAY_URL=https://llm.example.com/v1
LLM_GATEWAY_API_KEY=
# Postgres from `docker compose up -d db` (compose.yaml).
DATABASE_URL=postgresql://factory:factory@localhost:5432/factory

# Media providers (config/media.yaml), used by the `live` profile: FACTORY_MEDIA_PROFILE=live.
# Leave unset to run on the offline `fake` profile.
FACTORY_MEDIA_PROFILE=
# Azure AI Speech resource (F0 is free): key and region from the portal's "Keys and Endpoint".
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Cloudflare Workers AI: account id, and an API token with Workers AI Read + Edit.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# DeepInfra (paid fallback for images; switch to it in config/media.yaml).
DEEPINFRA_API_KEY=
# YouTube: OAuth client JSON (Desktop app) and where `factory media auth youtube` stores the token.
# Keep both outside the repo, one pair per environment (staging, production).
YOUTUBE_CLIENT_SECRETS=~/.config/yt-factory/staging/client_secret.json
YOUTUBE_TOKEN_PATH=~/.config/yt-factory/staging/youtube-token.json
# Set to 1 to run the `live` tests, which call real providers and may cost money.
FACTORY_LIVE_TESTS=
