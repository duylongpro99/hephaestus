{
  "$defs": {
    "QAIssue": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "title": "Category",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "line_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Line Id"
        },
        "severity": {
          "enum": [
            "minor",
            "major",
            "critical"
          ],
          "title": "Severity",
          "type": "string"
        },
        "suggested_fix": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suggested Fix"
        }
      },
      "required": [
        "line_id",
        "category",
        "severity",
        "description"
      ],
      "title": "QAIssue",
      "type": "object"
    },
    "ReviewerNote": {
      "additionalProperties": false,
      "description": "What one reviewer asked to change: a panel persona's issues, or a human's gate notes.",
      "properties": {
        "gate": {
          "enum": [
            0,
            1,
            2
          ],
          "title": "Gate",
          "type": "integer"
        },
        "issues": {
          "default": [],
          "items": {
            "$ref": "#/$defs/QAIssue"
          },
          "title": "Issues",
          "type": "array"
        },
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        },
        "reviewer": {
          "title": "Reviewer",
          "type": "string"
        }
      },
      "required": [
        "reviewer",
        "gate"
      ],
      "title": "ReviewerNote",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The notes of the latest reject that sent a script back for a rewrite (architecture \u00a75).",
  "properties": {
    "episode_id": {
      "title": "Episode Id",
      "type": "string"
    },
    "notes": {
      "items": {
        "$ref": "#/$defs/ReviewerNote"
      },
      "minItems": 1,
      "title": "Notes",
      "type": "array"
    },
    "rejected_by": {
      "title": "Rejected By",
      "type": "string"
    },
    "round": {
      "minimum": 1,
      "title": "Round",
      "type": "integer"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "episode_id",
    "round",
    "rejected_by",
    "notes"
  ],
  "title": "RevisionRequest",
  "type": "object"
}
